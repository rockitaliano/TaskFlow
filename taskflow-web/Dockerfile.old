# ===== STAGE 1: BUILD =====
# Node para instalar dependências e compilar o React
FROM node:20-alpine AS build
WORKDIR /app

# Copia package.json primeiro (cache do Docker — só reinstala se mudar)
COPY package.json package-lock.json ./
RUN npm ci

# Copia o restante e compila
COPY . .

# Variável de ambiente para o Vite saber a URL da API em produção
# O container da API vai se chamar "api" na rede do Docker
ARG VITE_API_URL=http://localhost:8080
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build
# Resultado: pasta /app/dist com index.html, assets, etc.

# ===== STAGE 2: SERVE =====
# Nginx serve os arquivos estáticos — imagem minúscula (~20MB)
FROM nginx:alpine AS runtime

# Copia os arquivos compilados para a pasta padrão do Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Configuração do Nginx para funcionar com React Router
# Sem isso, ao acessar /tasks/new diretamente dá 404
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]